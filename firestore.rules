rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email']) &&
             data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 200 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000)) &&
             (!('settings' in data) || (data.settings is map)) &&
             (!('createdAt' in data) || data.createdAt == request.time) &&
             data.updatedAt == request.time;
    }

    function isCollaborator(data) {
      return isSignedIn() && ('collaborators' in data) && (request.auth.uid in data.collaborators);
    }

    function isValidProjectMetadata(data) {
      return data.keys().hasAll(['id', 'ownerId', 'name']) &&
             data.id is string && data.id.size() <= 128 &&
             data.ownerId == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 1000)) &&
             (!('driveFileId' in data) || (data.driveFileId is string && data.driveFileId.size() <= 256)) &&
             (!('isPublic' in data) || data.isPublic is bool) &&
             (!('collaborators' in data) || (data.collaborators is list && data.collaborators.size() <= 20)) &&
             (!('createdAt' in data) || data.createdAt == request.time) &&
             data.updatedAt == request.time;
    }

    // --- Collection Routes ---

    // USERS
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidUserProfile(incoming()) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'settings', 'updatedAt']);
      allow delete: if false; // Users shouldn't delete their own profile data via client easily
    }

    // PROJECTS
    match /projects/{projectId} {
      allow get: if isSignedIn() && (isOwner(existing().ownerId) || existing().isPublic == true || isCollaborator(existing()));
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || resource.data.isPublic == true || isCollaborator(resource.data));
      allow create: if isSignedIn() && isValidId(projectId) && isValidProjectMetadata(incoming());
      allow update: if isSignedIn() && (isOwner(existing().ownerId) || isCollaborator(existing())) && isValidProjectMetadata(incoming()) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'driveFileId', 'isPublic', 'collaborators', 'updatedAt']);
      allow delete: if isSignedIn() && isOwner(existing().ownerId);
    }
  }
}
